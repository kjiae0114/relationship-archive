# Public template only. Replace every value in your local .env.
ARCHIVE_PASSWORD=REPLACE_WITH_STRONG_LOGIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=archive-photos
COOKIE_SECURE=false
# Optional: Kakao Local REST API key for Korean address search. Leave empty to use OpenStreetMap Nominatim.
KAKAO_REST_API_KEY=
